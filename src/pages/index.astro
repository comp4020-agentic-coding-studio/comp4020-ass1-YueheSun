---
import Layout from "../layouts/Layout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import { rounds } from "../data/rounds";
import { photoUrl } from "../data/round-photos";
---

<Layout title="Spot the Difference: Bird Edition">
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <div class="page-title">
      <svg class="title-bird" width="30" height="30" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M2 20 L9 17 L9 23 Z" />
        <ellipse fill="currentColor" cx="15" cy="19" rx="8" ry="6" />
        <circle fill="currentColor" cx="24" cy="11" r="4.5" />
        <path fill="currentColor" d="M28 10.5 L32.5 11.5 L28 13 Z" />
        <path fill="none" stroke="var(--bg)" stroke-width="1" d="M9 15 C13 11 18 13 20 17" />
        <line stroke="currentColor" stroke-width="1" x1="13" y1="25" x2="12" y2="29" />
        <line stroke="currentColor" stroke-width="1" x1="18" y1="25" x2="19" y2="29" />
        <circle fill="var(--bg)" cx="25.5" cy="10" r="0.7" />
      </svg>
      <h1>Spot the Difference: Bird Edition</h1>
    </div>
    <p class="intro">
      You keep misidentifying these look-alikes because you're looking at the
      wrong feature. Guess the bird, then see every feature that actually
      gives it away — and how it compares to the species it's most often
      confused with.
    </p>

    {
      rounds.map((round, index) => (
        <section class="round" data-testid="round" hidden={index !== 0}>
          <div class="stage">
            <div class="screen screen-guess" data-testid="screen-guess">
              <div class="board">
                <img
                  class="mystery-photo"
                  data-testid="mystery-photo"
                  src={photoUrl(round.primary.photoSlug)}
                  alt="Mystery bird — guess before revealing"
                  draggable="false"
                />
                {round.options.map((option) => (
                  <button
                    class={`option option-${option.position}`}
                    data-testid="option"
                    data-position={option.position}
                    data-name={option.name}
                    data-correct={option.correct ? "true" : undefined}
                  >
                    {option.name}
                  </button>
                ))}
              </div>
            </div>

            <div class="screen screen-detail" data-testid="screen-detail" hidden>
              <div class="detail-header">
                <p class="detail-outcome" data-testid="outcome" />
                <button class="detail-next detail-next-top" data-testid="detail-next" type="button">
                  Next
                </button>
              </div>

              <section class="panel panel-answer">
                <FeatureCard card={round.primary} />
              </section>

              <section class="panel panel-confusable">
                <details class="confusable-section">
                  <summary class="confusable-label">Often confused with</summary>
                  {round.confusables.length > 1 && (
                    <select
                      class="confusable-select"
                      data-testid="confusable-select"
                      aria-label="Compare with a similar-looking species"
                    >
                      {round.confusables.map((confusable, i) => (
                        <option value={i}>{confusable.name}</option>
                      ))}
                    </select>
                  )}
                  {round.confusables.map((confusable, i) => (
                    <div class="feature-card-panel" data-testid="confusable-panel" hidden={i !== 0}>
                      <FeatureCard card={confusable} comparisonNote={confusable.comparisonNote} />
                    </div>
                  ))}
                </details>
              </section>

              <button class="detail-next detail-next-bottom" data-testid="detail-next" type="button">
                Next
              </button>
            </div>
          </div>
        </section>
      ))
    }

    <div class="screen-complete" data-testid="complete" role="button" tabindex="0" hidden>
      <p class="complete-heading">That's all of them — play again?</p>
      <p class="complete-hint">(tap anywhere to restart)</p>
    </div>

    <p class="howto">
      Tap a name, press an arrow key, or swipe toward it. Then tap Next to continue.
    </p>
  </main>
  <script>
    import { initBirdGame } from "../scripts/birds";
    import { wireLeaderLines } from "../scripts/leader-lines";
    initBirdGame(document);
    wireLeaderLines(document);
  </script>
</Layout>
