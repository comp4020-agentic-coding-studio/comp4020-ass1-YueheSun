---
import Layout from "../layouts/Layout.astro";
import mysteryBirdUrl from "../assets/mystery-bird.svg?url";
---

<Layout title="Spot the Difference: Bird Edition">
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>Spot the Difference: Bird Edition</h1>
    <p class="intro">
      You keep misidentifying these look-alikes because you're looking at the
      wrong feature. Guess the bird, then see the one mark that actually
      gives it away.
    </p>

    <section class="round" data-testid="round">
      <div class="stage">
        <div class="screen screen-guess" data-testid="screen-guess">
          <div class="board">
            <img
              class="mystery-photo"
              data-testid="mystery-photo"
              src={mysteryBirdUrl}
              alt="Placeholder illustration of the mystery bird — real photos come next"
              draggable="false"
            />
            <button class="option option-top" data-testid="option" data-position="top" data-name="Eurasian Tree Sparrow">
              Eurasian Tree Sparrow
            </button>
            <button
              class="option option-left"
              data-testid="option"
              data-position="left"
              data-name="House Sparrow"
              data-correct="true"
              data-feature="a plain grey crown with no black cheek spot"
              data-notes="found around buildings worldwide; males have a black bib; noisy, gregarious flocks."
            >
              House Sparrow
            </button>
            <button class="option option-right" data-testid="option" data-position="right" data-name="Russet Sparrow">
              Russet Sparrow
            </button>
            <button class="option option-bottom" data-testid="option" data-position="bottom" data-name="Eurasian Sparrowhawk">
              Eurasian Sparrowhawk
            </button>
          </div>
        </div>

        <div class="screen screen-detail" data-testid="screen-detail" role="button" tabindex="0" hidden>
          <p class="detail-outcome" data-testid="outcome"></p>
          <p class="detail-feature" data-testid="detail-feature"></p>
          <img class="detail-photo" data-testid="detail-photo" alt="" draggable="false" />
          <p class="detail-notes" data-testid="detail-notes"></p>
          <p class="detail-hint">(tap anywhere to continue)</p>
        </div>
      </div>
    </section>

    <p class="howto">
      Tap a name, press an arrow key, or swipe toward it. Then tap anywhere to continue.
    </p>
  </main>
  <script>
    import { initBirdGame } from "../scripts/birds";
    initBirdGame(document);
  </script>
</Layout>
